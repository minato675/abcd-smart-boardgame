# 이 파일을 .env.local 로 복사해서 쓴다 (.gitignore 의 *.local 에 걸려 커밋되지 않음).
#
#   cp .env.example .env.local

# API 접두어. inte-server 에는 CORS 설정이 전혀 없으므로 반드시 same-origin 이어야 한다.
#   - 운영: 외부 nginx 가 /inte → inte-server:8111 로 넘긴다.
#   - 개발: vite.config.ts 의 server.proxy 가 같은 접두어를 프록시한다.
# 절대 URL(http://...)을 넣으면 브라우저가 CORS 로 막는다.
VITE_API_BASE_URL=/inte

# 개발용 프록시 대상. vite.config.ts 에서만 읽으며 브라우저로 나가지 않는다.
VITE_DEV_API_TARGET=http://localhost:8111
# 배포 서버에 직접 붙일 때: http://i15a402.p.ssafy.io

# 태블릿이 설치된 방. DB room 테이블의 room_number 와 정확히 일치해야 한다.
# 불일치하면 대여/예약이 전부 404 ROOM_NOT_FOUND 로 실패한다.
VITE_ROOM_NUMBER=room-01

# 헤더에 표시할 문구 (서버 값이 아니라 기기 설정값)
VITE_ROOM_LABEL=Room 1
VITE_CAFE_NAME=ABCd

# MQTT 브로커 WebSocket 주소. 태블릿이 /room/{VITE_ROOM_NUMBER}/# 를 직접 구독해
# 방 이벤트를 실시간으로 받는다(qna/ready, reservation/ready 등).
#
# REST 와 달리 프록시를 타지 않고 브로커에 직접 붙는다(WebSocket 은 CORS 대상이 아니다).
# 브로커에 WebSocket 리스너가 열려 있어야 한다 — mosquitto.conf 에 다음이 필요하다:
#   listener 9001
#   protocol websockets
#
# 페이지를 https 로 서비스하면 ws:// 는 mixed content 로 차단되니 wss:// 를 써야 한다.
# 비워 두면 구독을 건너뛴다 — 음성 도우미가 '준비 중' 에서 멈추고,
# 예약한 게임이 반납돼도 알림 팝업이 뜨지 않는다.
VITE_MQTT_URL=ws://i15a402.p.ssafy.io:8114

# 브로커에 인증이 걸려 있을 때만 채운다.
# 주의: 이 값은 브라우저 번들에 그대로 들어간다. 태블릿마다 계정을 나누고
# ACL 로 /room/{자기방}/# 만 구독하도록 막는 것을 권장한다.
VITE_MQTT_USERNAME=ssafy
VITE_MQTT_PASSWORD=ssafy

# ── 관리자 화면 (/admin) ─────────────────────────────────────────────
# 사물함 컨트롤러(라즈베리파이) 식별자. 강제 오픈이
# /cabinet/{controllerId}/{cabinetNumber}/open 으로 발행할 때 쓴다.
# 서버 쪽 DB room_rfid.controller_id, 컨트롤러 쪽 controller.conf 의
# controller_id 와 셋 다 같은 값이어야 한다.
VITE_CABINET_CONTROLLER_ID=rpi-01

# 관리자 화면이 관리할 방 번호 (쉼표 구분).
# 서버에 방 목록 조회 API 가 없어서 설정으로 받는다.
# DB room.room_number 와 다르면 그 방의 입/퇴실이 404 ROOM_NOT_FOUND 로 실패한다.
VITE_ADMIN_ROOM_NUMBERS=1,2,3,4,5,6
