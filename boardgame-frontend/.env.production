# 배포 빌드(`npm run build`, mode=production)에서 Vite 가 자동으로 읽는 파일.
#
# .env.local 과 달리 이 파일은 **커밋된다** (.gitignore 는 *.local 만 막는다).
# Jenkins 가 checkout 한 뒤 Dockerfile 안에서 빌드하므로, 배포본에 값이 들어가려면
# 여기 있어야 한다 — .env.local 은 저장소에 없어서 컨테이너까지 따라가지 못한다.
#
# 값은 빌드 시점에 번들로 인라인된다. 바꾸면 이미지를 다시 빌드해야 반영된다.

# 운영에서는 외부 nginx 가 /inte → inte-server:8111 로 넘긴다.
VITE_API_BASE_URL=/inte

# 이 태블릿이 설치된 방. DB room 테이블의 room_number 와 정확히 일치해야 한다.
# 이미지 하나에 박히는 값이라 태블릿이 여러 대가 되면 이 방식으로는 구분할 수 없다
# (지금은 데모용 태블릿 1대 기준).
VITE_ROOM_NUMBER=room-01

VITE_ROOM_LABEL=Room 1
VITE_CAFE_NAME=ABCd

# MQTT 브로커 WebSocket 주소. 브로커 쪽에도 websockets 리스너와 포트 개방이 되어 있어야 한다:
#   mosquitto.conf   : listener 9001 / protocol websockets
#   docker-compose   : "8114:9001"
#   EC2 보안 그룹     : TCP 8114 인바운드
VITE_MQTT_URL=ws://i15a402.p.ssafy.io:8114
VITE_MQTT_USERNAME=ssafy
VITE_MQTT_PASSWORD=ssafy
